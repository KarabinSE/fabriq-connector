{
    "name": "@fabriq/connector",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build && tsc --declaration --emitDeclarationOnly --noEmit false --outDir dist --rootDir resources/js",
        "prepare": "npm run build"
    },
    "peerDependencies": {
        "vue": "^3.5.0",
        "@inertiajs/vue3": "2 - 3"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.0",
        "typescript": "^5.0.0",
        "vite": "^7.3.7",
        "@inertiajs/vue3": "^3.0"
    }
}